# Trace harness output (see scripts/trace_pipeline.py).  Artifacts
# are reproducible from the harness, so keep them local-only by
# default; use ``git add -f runs/<slug>/<file>`` to commit a
# specific run as PR evidence.
runs/

# Paper sources (large; managed separately)
Papers/
Papers_rebuilt/

# Project-private notes
CLAUDE.md

# Regenerated scratch stub (geopandas downloaded.shp probe)
downloaded.shp

# OSM bridge-classification working artifacts (local-only; not used by the package).
# build_data/ holds the bridge working files (gpkgs, audit CSVs, methodology source)
# and is intentionally untracked. The loose /berea_*, /vrg_*, /caledon_*.json and
# /three_ways.json files are leftover Overpass query/response scratch dumps.
build_data/
/berea_*
/vrg_*
/caledon_*.json
/three_ways.json

# Personal one-off working scripts (machine-specific D:\ paths; not package code,
# nothing imports them, and pytest's testpaths=["tests"] excludes them).
# build_advisor_deck.py builds the advisor-meeting pptx into runs/; test_pr31_export.py
# is a manual live OpenAI export smoke test that reads a personal api.env path.
/scripts/build_advisor_deck.py
/scripts/test_pr31_export.py
